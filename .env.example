# The production origin. No trailing slash.
#
# Canonical tags, the sitemap, robots.txt and every absolute Open Graph URL are
# built from this one value — see SITE_URL in src/lib/studio.ts.
#
# Read at build time, and public by design: these URLs are part of the rendered
# HTML, so there is nothing secret here. Do not put credentials in this file or
# in any NEXT_PUBLIC_ variable.
#
# Left unset, the site falls back to a reserved .example host that can never be
# registered, so a missing value fails visibly rather than silently pointing
# canonicals at the wrong domain.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com
